{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/WENSHAO521/posi-data/main/schema/category.schema.json",
  "title": "POSI Subject Classification (PSC) Category",
  "type": "object",
  "required": ["code", "name", "level"],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^P[1-6](\\.[0-9]{2}){0,2}$",
      "description": "e.g. P3 (level 1), P3.03 (level 2), P3.03.04 (level 3)."
    },
    "name": { "type": "string" },
    "level": { "type": "integer", "enum": [1, 2, 3] },
    "parent": {
      "type": ["string", "null"],
      "description": "Parent category code. Null only for level-1 domains."
    },
    "description": { "type": ["string", "null"] },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Alternate names used to help the ML-suggested classifier and full-text search match this category."
    },
    "basis": {
      "type": "string",
      "const": "OECD Frascati Manual FORD",
      "description": "Level-1 domains follow the OECD Frascati Manual's Fields of Research and Development classification; levels 2–3 are POSI's own subdivision."
    }
  }
}
