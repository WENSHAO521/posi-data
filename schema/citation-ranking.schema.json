{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/WENSHAO521/posi-data/master/schema/citation-ranking.schema.json",
  "title": "POSI Citation Ranking record (CITATION-RANK-1.0)",
  "description": "One record per journal per edition (rankings/citation/citation-ranking-<Y>.json.gz, `records`). Rank, percentile, Citation Quartile and POSI Zone come from PNCI within the journal's primary PSC category (POSI-EVAL-1.0-SPEC.md § 5–11). PCS, PCI and total citations are descriptive only.",
  "type": "object",
  "required": [
    "journal_id",
    "metric_year",
    "citation_ranking_status",
    "zone_status",
    "ranking_snapshot_date",
    "evaluation_version",
    "ranking_methodology_version"
  ],
  "properties": {
    "journal_id": {
      "type": "string"
    },
    "metric_year": {
      "type": "integer",
      "minimum": 2020
    },
    "pnci": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "PNCI-1.0, unrounded. The ranking metric."
    },
    "pnci_model_version": {
      "type": [
        "string",
        "null"
      ],
      "description": "e.g. PNCI-1.0"
    },
    "pnci_normalization": {
      "enum": [
        "field_year_type",
        "field_year_type+field_year_fallback",
        null
      ]
    },
    "eligible_citable_items": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "publication_years": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "citation_coverage": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "PCS-1.0 pcs_coverage: DOIs fetched / DOIs enumerated."
    },
    "median_normalized_citation": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Descriptive, not ranked."
    },
    "top10_share": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "Descriptive, not ranked."
    },
    "total_citations": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Descriptive only; never a ranking input."
    },
    "pci": {
      "type": [
        "number",
        "null"
      ],
      "description": "PCI-1.0, descriptive."
    },
    "pcs": {
      "type": [
        "number",
        "null"
      ],
      "description": "PCS-1.0, supplementary; never a ranking input."
    },
    "pcs_methodology_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycle_stage": {
      "enum": [
        "observation",
        "early_stage",
        "mature",
        null
      ]
    },
    "ranking_category_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Primary PSC category; null for multidisciplinary or unclassified journals."
    },
    "ranking_category_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "category_cohort_size": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "citation_rank": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Competition rank (1, 2, 2, 4)."
    },
    "citation_rank_mid": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0.5,
      "description": "Mid-rank of the tied group."
    },
    "citation_rank_total": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 20,
      "description": "Category cohort size N."
    },
    "citation_percentile": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "100 × (N − rank_mid + 0.5) / N, full precision."
    },
    "citation_quartile": {
      "enum": [
        "Q1",
        "Q2",
        "Q3",
        "Q4",
        null
      ],
      "description": "Citation Quartile, displayed C-Q1…C-Q4. The only Q value POSI publishes."
    },
    "posi_zone": {
      "enum": [
        1,
        2,
        3,
        4,
        null
      ]
    },
    "zone_status": {
      "enum": [
        "official",
        "provisional",
        "not_assigned"
      ]
    },
    "citation_ranking_status": {
      "enum": [
        "official",
        "provisional",
        "insufficient_items",
        "insufficient_category",
        "incomplete_coverage",
        "observation",
        "not_available"
      ]
    },
    "ranking_status_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "tied_with": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ranking_snapshot_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "ranking_methodology_version": {
      "const": "CITATION-RANK-1.0"
    },
    "zones_version": {
      "type": "string"
    },
    "evaluation_version": {
      "const": "POSI-EVAL-1.0"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "publisher": {
      "type": [
        "string",
        "null"
      ]
    },
    "issn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_access": {
      "type": [
        "boolean",
        "null"
      ]
    }
  }
}
